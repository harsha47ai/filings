# Copy to .env and set values. For Neon + Netlify + GoDaddy see README Deployment section.

# Local: use your PostgreSQL URL. Production (Neon): use Neon connection string in Netlify env.
DATABASE_URL="postgresql://user:password@localhost:5432/indiafilings?schema=public"

# Run: openssl rand -base64 32. Set same value in Netlify.
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Local: http://localhost:3000. Production: https://yourdomain.com (set in Netlify after GoDaddy domain).
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
